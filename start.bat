@echo off
REM ====================================================================
REM Запускает скрипт "ВЫПУСК.РУ"
REM ====================================================================

REM Устанавливаем кодировку UTF-8 для корректного отображения кириллицы
chcp 65001 > nul

echo Запуск приложения "ВЫПУСК.РУ"...

REM %~dp0 - это специальная переменная, означающая "путь к папке, где лежит этот .bat файл".
REM Это гарантирует, что скрипт будет запущен из правильной директории
REM и сможет найти папку 'assets' и файл 'PhotoSorter_GUI.pyw'.
REM ИСПРАВЛЕНА ОПЕЧАТКА: cd /d %~dp0
cd /d %~dp0

REM --- ЗАПУСК СКРИПТА ---
REM Убедитесь, что 'python' (или 'python3') добавлен в ваш системный PATH.
REM Если вы используете виртуальное окружение (venv),
REM раскомментируйте следующую строку:
REM call venv\Scripts\activate

REM ИСПРАВЛЕНО: Имя файла соответствует вашему скриншоту
python PhotoSorter_GUI.pyw

echo.
echo Приложение "ВЫПУСК.РУ" закрыто.
pause